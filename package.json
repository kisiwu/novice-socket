{
  "name": "@novice1/socket",
  "private": false,
  "version": "0.4.8",
  "description": "Simplifies creating server-side Socket.IO applications by providing namespace and event builders, middleware support, and utilities for robust real-time communication.",
  "main": "lib/index.js",
  "homepage": "https://kisiwu.github.io/novice-socket/latest/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kisiwu/novice-socket.git"
  },
  "scripts": {
    "doc": "typedoc",
    "build": "npm exec tsc",
    "lint": "eslint .",
    "test": "kaukau --require ts-node/register --config kaukau-config-src.json",
    "testlib": "kaukau --config kaukau-config-lib.json",
    "format": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --write ./src",
    "format:check": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --check ./src",
    "format:staged": "cross-env NODE_OPTIONS=--experimental-strip-types lint-staged"
  },
  "author": "demingongo",
  "license": "MIT",
  "dependencies": {
    "array-flatten": "^3.0.0",
    "socket.io": "^4.8.4",
    "socket.io-adapter": "^2.5.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-mocha": "^11.3.0",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "kaukau": "^5.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-eslint": "^8.71.2"
  }
}